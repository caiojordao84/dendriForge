       pin_to_logical_expr(
                            resolve_pin_number(&sda, &self.pin_consts).unwrap_or(0),
                            &self.pin_consts,
                        ),
                        pin_to_logical_expr(
                            resolve_pin_number(&scl, &self.pin_consts).unwrap_or(0),
                            &self.pin_consts,
                        ),
                        parse_expr(&freq).unwrap_or(Expr::Int { value: 400_000 }),
                    ],
                });
            }
            // spi_1 = SPI(1, baudrate=..., sck=Pin(..), mosi=Pin(..), miso=Pin(..))
            if let Some((bus, mosi, miso, sck)) = parse_spi_ctor(&rhs) {
                return Ok(Stmt::Call {
                    name: "CFG_SPI".into(),
                    args: vec![
                        parse_expr(&bus).unwrap_or(Expr::Uint { value: 1 }),
                        Expr::Uint {
                            value: resolve_pin_number(&mosi, &self.pin_consts).unwrap_or(0) as u64,
                        },
                        parse_expr(&miso).unwrap_or(Expr::Int { value: -1 }),
                        Expr::Uint {
                            value: resolve_pin_number(&sck, &self.pin_consts).unwrap_or(0) as u64,
                        },
                        Expr::Uint { value: 5 }, // CS not always in SPI() — default for subset
                    ],
                });
            }
            // q = TON(...)
            let value = parse_expr(&rhs).map_err(|e| self.err(line, e.to_string()))?;
            return Ok(Stmt::Assign {
                target: lhs,
                value: rewrite_expr(value, &self.pin_consts, &self.obj_to_pin),
            });
        }

        // led_pin.value(1)  or sleep_ms(ON_TIME) or pwm.duty_u16 / uart.write
        if let Some((obj, method, args)) = parse_obj_method(t) {
            if method == "value" {
                let pin = self
                    .obj_to_pin
                    .get(&obj)
                    .copied()
                    .or_else(|| {
                        // fallback: strip _pin and look up upper
                        let key = to_upper_snake(obj.trim_end_matches("_pin"));
                        self.pin_consts.get(&key).copied()
                    })
                    .unwrap_or(0);
                let pin_expr = pin_to_logical_expr(pin, &self.pin_consts);
                if args.is_empty() {
                    // read — shouldn't be stmt
                    return Ok(Stmt::Assign {
                        target: "_".into(),
                        value: Expr::Call {
                            name: "GET_BOOL".into(),
                            args: vec![pin_expr],
                        },
                    });
                }
                let val = parse_expr(&args[0])?;
                let val = match val {
                    Expr::Uint { value: 1 } => Expr::Bool { value: true },
                    Expr::Uint { value: 0 } => Expr::Bool { value: false },
                    other => other,
                };
                return Ok(Stmt::Call {
                    name: "SET_BOOL".into(),
                    args: vec![pin_expr, val],
                });
            }
            if method == "duty_u16" || method == "duty" {
                let pin = self.obj_to_pin.get(&obj).copied().unwrap_or(0);
                let duty = if args.is_empty() {

}

    fn parse_cmp(&mut self) -> Result<Expr, MpyParseError> {
        let mut left = self.parse_add()?;
        loop {
            self.skip_ws();
            let op = if self.rest().starts_with("==") {
                self.i += 2;
                BinaryOp::Eq
            } else if self.rest().starts_with("!=") {
                self.i += 2;
                BinaryOp::Ne
            } else if self.rest().starts_with("<=") {
                self.i += 2;
                BinaryOp::Le
            } else if self.rest().starts_with(">=") {
                self.i += 2;
                BinaryOp::Ge
            } else if self.rest().starts_with('<') {
                self.i += 1;
                BinaryOp::Lt
            } else if self.rest().starts_with('>') {
                self.i += 1;
                BinaryOp::Gt
            } else {
                break;
            };
            let right = self.parse_add()?;
            left = Expr::Binop {
                op,
                left: Box::new(left),
                right: Box::new(right),
            };
        }
        Ok(left)
    }

    fn parse_add(&mut self) -> Result<Expr, MpyParseError> {
        let mut left = self.parse_mul()?;
        loop {
            self.skip_ws();
            let op = if self.rest().starts_with('+') {
                self.i += 1;
                BinaryOp::Add
            } else if self.rest().starts_with('-') {
                self.i += 1;
                BinaryOp::Sub
            } else {
                break;
            };
            let right = self.parse_mul()?;
            left = Expr::Binop {
                op,
                left: Box::new(left),
                right: Box::new(right),
            };
        }
        Ok(left)
    }

    fn parse_mul(&mut self) -> Result<Expr, MpyParseError> {
        let mut left = self.parse_unary()?;
        loop {
            self.skip_ws();
            let op = if self.rest().starts_with('*') {
                self.i += 1;
                BinaryOp::Mul
            } else if self.rest().starts_with('/') {
                self.i += 1;
                BinaryOp::Div
            } else if self.rest().starts_with('%') {
                self.i += 1;
                BinaryOp::Mod
            } else {
                break;
            };
            let right = self.parse_unary()?;
            left = Expr::Binop {
                op,
                left: Box::new(left),
                right: Box::new(right),
            };
        }
        Ok(left)
    }

    fn parse_unary(&mut self) -> Result<Expr, MpyParseError> {
        self.skip_ws();
        if self.rest().starts_with('-') {
            self.i += 1;
            let inner = self.parse_unary()?;
            return Ok(match inner {
                Expr::Uint { value } if value <= i64::MAX as u64 => Expr::Int {
                    value: -(value as i64),
                },
                Expr::Int { value } => Expr::Int { value: -value },
                Expr::Real { value } => Expr::Real { value: -value },
                other => Expr::Unary {
                    op: UnaryOp::Neg,
                    expr: Box::new(other),
                },
            });
        }
        if self.rest().starts_with('~') {
            self.i += 1;
            return Ok(Expr::Unary {
                op: UnaryOp::BitNot,
                expr: Box::new(self.parse_unary()?),
            });
        }
        self.parse_primary()
    }


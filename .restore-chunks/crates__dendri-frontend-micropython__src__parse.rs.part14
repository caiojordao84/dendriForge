 > 0 {
                        self.i += 1;
                    }
                }
                let args_s = self.s[args_start..self.i].to_string();
                if self.i < self.s.len() {
                    self.i += 1; // )
                }
                // method call obj.value() / obj.read_u16() / obj.duty_u16()
                if let Some((obj, method)) = name.rsplit_once('.') {
                    if method == "value" {
                        return Ok(Expr::Call {
                            name: "GET_BOOL".into(),
                            args: vec![Expr::Var {
                                name: obj.to_string(),
                            }],
                        });
                    }
                    if method == "read_u16" {
                        return Ok(Expr::Call {
                            name: "READ_ADC".into(),
                            args: vec![Expr::Var {
                                name: obj.to_string(),
                            }],
                        });
                    }
                    if method == "duty_u16" && args_s.trim().is_empty() {
                        return Ok(Expr::Call {
                            name: "GET_PWM_DUTY".into(),
                            args: vec![Expr::Var {
                                name: obj.to_string(),
                            }],
                        });
                    }
                    if obj.starts_with("uart_") {
                        let opcode = match method {
                            "any" => Some("SERIAL_AVAILABLE"),
                            "read" => Some("SERIAL_READ"),
                            "readline" => Some("SERIAL_READLN"),
                            _ => None,
                        };
                        if let Some(op) = opcode {
                            return Ok(Expr::Call {
                                name: op.into(),
                                args: vec![],
                            });
                        }
                    }
                }
                let args = if args_s.trim().is_empty() {
                    vec![]
                } else {
                    parse_arg_list(&args_s)?
                };
                return Ok(Expr::Call { name, args });
            }
            // ternary sugar already handled elsewhere
            if name.contains('.') {
                // Pin.OUT etc as var
                return Ok(Expr::Var { name });
            }
            return Ok(Expr::Var { name });
        }
        // ternary: 1 if cond else 0
        if let Some(expr) = try_parse_ternary(self.s) {
            self.i = self.s.len();
            return Ok(expr);
        }
        Err(MpyParseError::At {
            line: 0,
            message: format!("bad expr near '{}'", self.rest()),
        })
    }
}

fn try_parse_ternary(s: &str) -> Option<Expr> {
    // 1 if X else 0
    let (then_s, rest) = s.split_once(" if ")?;
    let (cond_s, else_s) = rest.split_once(" else ")?;
    let then_e = parse_expr(then_s.trim()).ok()?;
    let cond = parse_expr(cond_s.trim()).ok()?;
    let else_e = parse_expr(else_s.trim()).ok()?;
    Some(Expr::Call {
        name: "SEL".into(),
        args: vec![cond, else_e, then_e],
    })
}


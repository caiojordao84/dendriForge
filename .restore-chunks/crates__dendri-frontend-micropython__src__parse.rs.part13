sult<Expr, MpyParseError> {
        self.skip_ws();
        let r = self.rest();
        if r.starts_with("True") {
            self.i += 4;
            return Ok(Expr::Bool { value: true });
        }
        if r.starts_with("False") {
            self.i += 5;
            return Ok(Expr::Bool { value: false });
        }
        if r.starts_with('(') {
            self.i += 1;
            // ternary: (1 if x else 0)
            let inner = self.parse_or()?;
            self.skip_ws();
            if self.rest().starts_with(')') {
                self.i += 1;
                return Ok(inner);
            }
            return Err(MpyParseError::At {
                line: 0,
                message: "expected ')'".into(),
            });
        }
        if r.starts_with('"') || r.starts_with('\'') {
            let quote = r.chars().next().unwrap();
            self.i += 1;
            let start = self.i;
            while self.i < self.s.len() && self.s.as_bytes()[self.i] as char != quote {
                self.i += 1;
            }
            let val = self.s[start..self.i].to_string();
            if self.i < self.s.len() {
                self.i += 1;
            }
            return Ok(Expr::String { value: val });
        }
        if r.starts_with(|c: char| c.is_ascii_digit()) {
            let bytes = self.s.as_bytes();
            // Hex: 0x3C / 0XA5 — preserve Expr::Hex spelling for round-trip.
            if r.starts_with("0x") || r.starts_with("0X") {
                let start = self.i;
                self.i += 2;
                while self.i < self.s.len() && bytes[self.i].is_ascii_hexdigit() {
                    self.i += 1;
                }
                let hex = self.s[start..self.i].to_string();
                if hex.len() <= 2 {
                    return Err(MpyParseError::At {
                        line: 0,
                        message: "expected hex digits after 0x".into(),
                    });
                }
                return Ok(Expr::Hex { value: hex });
            }
            let start = self.i;
            while self.i < self.s.len()
                && (bytes[self.i].is_ascii_digit() || bytes[self.i] == b'.')
            {
                self.i += 1;
            }
            let num = &self.s[start..self.i];
            if num.contains('.') {
                return Ok(Expr::Real {
                    value: num.parse().unwrap_or(0.0),
                });
            }
            return Ok(Expr::Uint {
                value: num.parse().unwrap_or(0),
            });
        }
        if r.starts_with(|c: char| c.is_ascii_alphabetic() || c == '_') {
            let start = self.i;
            while self.i < self.s.len() {
                let c = self.s.as_bytes()[self.i] as char;
                if c.is_ascii_alphanumeric() || c == '_' || c == '.' {
                    self.i += 1;
                } else {
                    break;
                }
            }
            let name = self.s[start..self.i].to_string();
            self.skip_ws();
            if self.rest().starts_with('(') {
                self.i += 1;
                let args_start = self.i;
                let mut depth = 1i32;
                while self.i < self.s.len() && depth > 0 {
                    match self.s.as_bytes()[self.i] as char {
                        '(' => depth += 1,
                        ')' => depth -= 1,
                        _ => {}
                    }
                    if depth
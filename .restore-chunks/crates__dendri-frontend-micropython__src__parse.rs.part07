                 rewrite_expr(
                        parse_expr(&args[0])?,
                        &self.pin_consts,
                        &self.obj_to_pin,
                    )
                };
                return Ok(Stmt::Call {
                    name: "SET_PWM_DUTY".into(),
                    args: vec![pin_to_logical_expr(pin, &self.pin_consts), duty],
                });
            }
            if method == "freq" {
                let pin = self.obj_to_pin.get(&obj).copied().unwrap_or(0);
                let hz = rewrite_expr(
                    parse_expr(&args.first().cloned().unwrap_or_else(|| "0".into()))?,
                    &self.pin_consts,
                    &self.obj_to_pin,
                );
                return Ok(Stmt::Call {
                    name: "SET_PWM_FREQ".into(),
                    args: vec![pin_to_logical_expr(pin, &self.pin_consts), hz],
                });
            }
            if obj.starts_with("uart_") && method == "write" {
                let raw = args.first().cloned().unwrap_or_default();
                if let Some(msg) = raw.strip_suffix(" + \"\\n\"")
                    .or_else(|| raw.strip_suffix(" + '\\n'"))
                {
                    let msg_e = rewrite_expr(
                        parse_expr(msg.trim())?,
                        &self.pin_consts,
                        &self.obj_to_pin,
                    );
                    return Ok(Stmt::Call {
                        name: "SERIAL_PRINTLN".into(),
                        args: vec![msg_e],
                    });
                }
                let msg_e = rewrite_expr(
                    parse_expr(&raw)?,
                    &self.pin_consts,
                    &self.obj_to_pin,
                );
                return Ok(Stmt::Call {
                    name: "SERIAL_PRINT".into(),
                    args: vec![msg_e],
                });
            }
            if obj.starts_with("uart_") && method == "flush" {
                return Ok(Stmt::Call {
                    name: "SERIAL_FLUSH".into(),
                    args: vec![],
                });
            }
        }

        if let Some((name, args_s)) = parse_call(t) {
            let args = parse_arg_list(&args_s)?;
            let args: Vec<_> = args
                .into_iter()
                .map(|a| rewrite_expr(a, &self.pin_consts, &self.obj_to_pin))
                .collect();
            match name.as_str() {
                "sleep_ms" => {
                    return Ok(Stmt::Call {
                        name: "WAIT_TIME".into(),
                        args,
                    });
                }
                "sleep_us" => {
                    return Ok(Stmt::Call {
                        name: "WAIT_TIME_US".into(),
                        args,
                    });
                }
                "VENDOR_EXTENSION" => {
                    let reason = match args.first() {
                        Some(Expr::String { value }) => value.clone(),
                        Some(other) => format!("{other:?}"),
                        None => String::new(),
                    };
                    return Ok(Stmt::VendorExtension { reason });
                }
                other => {
                    return Ok(Stmt::Call {
                        name: other.into(),
                        args,
                    });
                }
            }
        }

        Err(self.err(line, format!("
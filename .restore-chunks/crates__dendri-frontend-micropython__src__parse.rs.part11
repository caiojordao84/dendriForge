{
    let (name, rest) = t.split_once('(')?;
    let args = rest.strip_suffix(')')?;
    if name.contains('.') {
        return None;
    }
    Some((name.trim().to_string(), args.to_string()))
}

fn split_args(s: &str) -> Vec<String> {
    let mut out = Vec::new();
    let mut cur = String::new();
    let mut depth = 0i32;
    let mut in_str: Option<char> = None;
    let mut escape = false;
    for c in s.chars() {
        if let Some(q) = in_str {
            cur.push(c);
            if escape {
                escape = false;
            } else if c == '\\' {
                escape = true;
            } else if c == q {
                in_str = None;
            }
            continue;
        }
        match c {
            '"' | '\'' => {
                in_str = Some(c);
                cur.push(c);
            }
            '(' => {
                depth += 1;
                cur.push(c);
            }
            ')' => {
                depth -= 1;
                cur.push(c);
            }
            ',' if depth == 0 => {
                out.push(cur.trim().to_string());
                cur.clear();
            }
            _ => cur.push(c),
        }
    }
    if !cur.trim().is_empty() {
        out.push(cur.trim().to_string());
    }
    out
}

fn parse_arg_list(s: &str) -> Result<Vec<Expr>, MpyParseError> {
    if s.trim().is_empty() {
        return Ok(vec![]);
    }
    split_args(s)
        .into_iter()
        .map(|a| parse_expr(&a))
        .collect()
}

fn parse_expr(s: &str) -> Result<Expr, MpyParseError> {
    let s = s.trim();
    ExprParser { s, i: 0 }.parse_or()
}

struct ExprParser<'a> {
    s: &'a str,
    i: usize,
}

impl<'a> ExprParser<'a> {
    fn rest(&self) -> &'a str {
        &self.s[self.i..]
    }

    fn skip_ws(&mut self) {
        while self.rest().starts_with(char::is_whitespace) {
            self.i += 1;
        }
    }

    fn parse_or(&mut self) -> Result<Expr, MpyParseError> {
        let mut left = self.parse_and()?;
        loop {
            self.skip_ws();
            if self.rest().starts_with("or ") || self.rest() == "or" {
                self.i += 2;
                self.skip_ws();
                let right = self.parse_and()?;
                left = Expr::Binop {
                    op: BinaryOp::Or,
                    left: Box::new(left),
                    right: Box::new(right),
                };
            } else {
                break;
            }
        }
        Ok(left)
    }

    fn parse_and(&mut self) -> Result<Expr, MpyParseError> {
        let mut left = self.parse_not()?;
        loop {
            self.skip_ws();
            if self.rest().starts_with("and ") || self.rest().starts_with("and(") {
                self.i += 3;
                self.skip_ws();
                let right = self.parse_not()?;
                left = Expr::Binop {
                    op: BinaryOp::And,
                    left: Box::new(left),
                    right: Box::new(right),
                };
            } else {
                break;
            }
        }
        Ok(left)
    }

    fn parse_not(&mut self) -> Result<Expr, MpyParseError> {
        self.skip_ws();
        if self.rest().starts_with("not ") || self.rest().starts_with("not(") {
            self.i += 3;
            self.skip_ws();
            return Ok(Expr::Unary {
                op: UnaryOp::Not,
                expr: Box::new(self.parse_not()?),
            });
        }
        self.parse_cmp()
    